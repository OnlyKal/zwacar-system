# Nginx — reverse proxy HTTPS vers l'API ZwaCar (qui sert aussi le Web Admin avec SERVE_WEB=true).
# Certificat : certbot --nginx -d zwacar.votredomaine.com
server {
    listen 80;
    server_name zwacar.votredomaine.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name zwacar.votredomaine.com;

    ssl_certificate     /etc/letsencrypt/live/zwacar.votredomaine.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zwacar.votredomaine.com/privkey.pem;

    # Vidéos 20 Mo + 12 photos de 10 Mo par envoi
    client_max_body_size 150m;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
