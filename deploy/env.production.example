# =====================================================================
# ZwaCar — configuration de PRODUCTION (copier vers server/.env)
# Le serveur refuse de démarrer si un secret est faible ou une URL non HTTPS.
# =====================================================================
NODE_ENV=production
PORT=4100
APP_NAME=ZwaCar

# URLs publiques (HTTPS obligatoire). Hébergement sur un seul domaine (SERVE_WEB=true) :
# les trois valeurs sont identiques.
WEB_URL=https://zwacar.votredomaine.com
API_URL=https://zwacar.votredomaine.com
CORS_ORIGINS=https://zwacar.votredomaine.com

# L'API sert le Web Admin compilé (web/dist) → un seul processus, un seul domaine
SERVE_WEB=true
# Documentation /api/docs (désactivée par défaut en production)
API_DOCS=false

# ---------- Base de données MySQL (utf8mb4) ----------
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zwacar
DB_USER=zwacar
DB_PASSWORD=

# ---------- Secrets (générer, ne jamais réutiliser ceux du développement) ----------
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (à conserver précieusement)
ENCRYPTION_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------- Fichiers ----------
# Dossier des médias et sauvegardes (à inclure dans la sauvegarde du serveur)
STORAGE_DIR=storage

# ---------- Tâches planifiées (une seule instance avec JOBS_ENABLED=true) ----------
JOBS_ENABLED=true
CRON_EXPIRATIONS=0 * * * *

# ---------- Premier lancement : npm run seed -- --no-demo ----------
SEED_ADMIN_EMAIL=admin@votredomaine.com
# 12 caractères minimum, lettres et chiffres
SEED_ADMIN_PASSWORD=
