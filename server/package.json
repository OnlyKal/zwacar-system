{
  "name": "zwacar-server",
  "version": "1.0.0",
  "description": "ZwaCar — API REST de la plateforme de location de véhicules",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:sync": "node src/scripts/sync.js",
    "seed": "node src/scripts/seed.js",
    "jobs:run": "node src/scripts/run-jobs.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "brand": "node src/scripts/brand-assets.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
