# ---------- Application ----------
NODE_ENV=development
PORT=4100
APP_NAME=ZwaCar
# URL publique du Web Admin (liens dans les emails)
WEB_URL=http://localhost:5180
# URL publique de l'API (liens médias)
API_URL=http://localhost:4100
CORS_ORIGINS=http://localhost:5180

# ---------- Base de données ----------
# sqlite (développement) | mysql (production)
DB_DIALECT=sqlite
DB_STORAGE=storage/data/zwacar.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zwacar
DB_USER=root
DB_PASSWORD=

# ---------- Sécurité ----------
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Clé de chiffrement AES-256 (64 caractères hexadécimaux) pour les identifiants SMTP
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------- Hébergement ----------
# L'API sert le Web Admin compilé (web/dist) : SERVE_WEB=true
SERVE_WEB=false
# Documentation /api/docs (par défaut : active en développement, désactivée en production)
# API_DOCS=true
# Dossier des médias et sauvegardes (défaut : storage)
# STORAGE_DIR=storage

# ---------- Tâches planifiées ----------
# Expression cron pour le traitement des expirations (défaut : toutes les heures)
CRON_EXPIRATIONS=0 * * * *
JOBS_ENABLED=true

# ---------- Seed ----------
SEED_ADMIN_EMAIL=admin@zwacar.com
# Développement uniquement — en production : 12 caractères minimum (voir deploy/env.production.example)
SEED_ADMIN_PASSWORD=Admin@12345
